{
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "caveman": { "source": { "source": "github", "repo": "juliusbrussee/caveman" } }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 300 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Grep", "hooks": [ { "type": "command", "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard search", "timeout": 10 } ] },
      { "matcher": "Read|Glob", "hooks": [ { "type": "command", "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard read", "timeout": 10 } ] }
    ]
  }
}
